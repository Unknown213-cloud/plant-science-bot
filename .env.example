# ==============================================================================
# Plant Science Bot - Environment Credentials
# ==============================================================================

# 1. Google Gemini AI API Key (for topic research synthesis)
# Obtain free at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. YouTube Data API v3 Key (for popular science video trends)
# Obtain at: https://console.cloud.google.com/ -> Enable YouTube Data API v3 -> Credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# 3. Instagram Graph API (with Instagram Login)
# Obtain via Meta for Developers: https://developers.facebook.com/
# Generate a long-lived user access token with instagram_basic, instagram_content_publish
IG_ACCESS_TOKEN=your_long_lived_instagram_user_access_token_here
IG_USER_ID=your_instagram_user_id_here

# 4. Optional Overrides
# GITHUB_REPOSITORY=Unknown213-cloud/plant-science-bot
# GITHUB_REF_NAME=main
# GH_PAT=your_github_personal_access_token_for_token_refresh
